# zentao-max 配置模板
# 复制为 backend/config.yaml 使用；不提供配置文件时应用使用内置默认值。
#
# 配置优先级：环境变量（ZENTAO_MAX_ 前缀）> 配置文件 > 内置默认值
# 环境变量命名：配置项下划线连接，如 server.port → ZENTAO_MAX_SERVER_PORT

# ==================== 服务器配置 ====================
server:
  # HTTP 服务器端口
  port: "12345"
  # 静态资源路径（仅 -static 磁盘伺服模式使用；默认为编译期嵌入的 frontend 产物）
  # static_path: "../frontend/dist"
  # 读/写超时（秒）
  read_timeout: 120
  write_timeout: 120
  # 优雅关闭超时（秒）
  shutdown_timeout: 30

# ==================== 禅道配置 ====================
# 运行时可在设置页「连接配置」卡片热更新（平台登录后，POST /api/v1/zentao-config）。
# 生效优先级（按字段逐项比较，非整记录）：设置页保存(auth.db) > 环境变量 >
# 本文件 > ldflags > 内置默认值——auth.db 记录里为空的字段自动回退到下一级，
# 历史遗留的残缺记录不会盖掉本文件的配置。
zentao:
  # 禅道服务器地址，如 https://zentao.example.com
  # 环境变量：ZENTAO_MAX_ZENTAO_SERVER（或无前缀 ZENTAO_SERVER）
  server: ""
  # 禅道账号（环境变量 ZENTAO_MAX_ZENTAO_ACCOUNT）
  account: ""
  # 禅道密码（环境变量 ZENTAO_MAX_ZENTAO_PASSWORD）
  password: ""
  # 认证域：留空 = Token REST 模式（/api.php/v1/*）；
  # 非空（如 kydc）= Session 模式（*.json 会话端点，适配禁用 REST API 的受限实例）
  realm: ""
  # 请求超时（秒）
  request_timeout: 120

# ==================== 认证配置 ====================
auth:
  # auth.db 路径。留空时由 ResolveAuthDBPath 统一解析：
  #   显式配置 → ZENTAO_AUTH_DB_PATH → 已存在候选（./data/auth.db → ./auth.db →
  #   ~/.zentao-max/auth.db）→ 默认 ./data/auth.db
  # db_path: "./data/auth.db"
  # 本地账号密码登录已移除：登录仅支持公司 SSO（auth.sso）
  # SSO 统一认证平台登录（用户名+密码+短信验证码协议）。默认关闭；
  # 对接自有统一认证平台时启用并配置地址（代码不内置任何平台地址）。
  # 也可在登录后于设置页「SSO 登录配置」在线修改（保存即生效并存入 auth.db，
  # 优先于本文件；本文件仅作为首次部署 bootstrap）
  sso:
    enabled: false
    # 认证平台根地址（启用 SSO 时必填）
    # base_url: "https://sso.example.com"
    # 登录页完整地址（作为 Referer 发送，服务端可能校验；留空回退 {base_url}/sso/auth）
    # auth_page_url: "https://sso.example.com/sso/auth?redirect=https%3A%2F%2Fportal.example.com&client_id=portal"

# ==================== 安全配置 ====================
security:
  # auth.db 加密密钥。未设置时使用托管密钥文件（auth.db 同目录 encryption.key，
  # 首次生成后稳定）；跨机器搬迁 auth.db 时请连同密钥文件一起拷贝，
  # 或显式固定本密钥（环境变量 ZENTAO_ENCRYPTION_KEY）
  encryption_key: ""
  # CORS 允许的域名（生产环境建议收紧；同域部署无需配置）
  allowed_origins:
    - "http://localhost:5173"

# ==================== 日志配置 ====================
log:
  # 级别: debug, info, warn, error
  level: info
  # 格式: json（生产）, console（开发）
  format: console
  # 输出路径：空 = 标准输出；stderr = 标准错误；其余为文件路径
  output_path: ""
  enable_caller: true
  enable_stacktrace: false

# ==================== 限流配置 ====================
rate_limit:
  # 每分钟请求数（oekit 令牌桶平滑限流，按 IP 直连地址维度；基础设施路径豁免）
  requests_per_minute: 600
  # 【兼容保留，不生效】旧固定窗口方案的封禁时长；现为纯令牌桶（超限即拒 429）
  block_duration_minutes: 5

# ==================== MCP 配置 ====================
mcp:
  # 是否启用 MCP 服务（运行时可经 /api/v1/mcp/config 热重载）
  enabled: true
  # 传输模式: http | stdio | both（由启动入口决定，运行时不可改）
  transport: http
  # 鉴权 Token（空 = 不鉴权；运行时热重载，服务端仅存哈希）
  token: ""
  # 只读模式：true 时拦截 record_effort / add_bug_comment / transition_bug 写工具
  read_only: false
  # action 白名单，空 = 允许全部
  actions: []

# ==================== 软件更新 ====================
update:
  # 启动注册检查 + 每 24h 定期检查（关闭后设置页仍可手动检查）
  enabled: true
  # 版本发布管理服务 API 前缀（含版本段），业务路径由客户端拼接：
  # {release_url}/products/{slug}/upgrade-check（服务端版本比较 + force_update
  # + 发布说明 Markdown + 渠道台账）。作为首选检查源，优先于 check_url 与
  # GitHub Releases。该源任何失败（网络/非 200/响应异常）一律静默降级：
  # 保留上次检查结果，状态接口与 UI 不暴露错误，仅内部日志。
  # 环境变量：ZENTAO_MAX_UPDATE_RELEASE_URL
  release_url: "https://api.murphyyi.com/vms/v1"
  # 产品标识（版本发布管理服务注册的 slug）。环境变量 ZENTAO_MAX_UPDATE_SLUG
  slug: "zentao-max"
  # 自建更新服务地址（POST JSON {app,version,os,arch}；响应
  # {latest_version,download_url,notes}）。release_url 为空时的检查源。
  check_url: ""
  # GitHub 仓库（release_url/check_url 均为空时的默认检查源）
  github_repo: "yi-nology/zentao-max"
  # 定期检查间隔（小时）
  interval_hours: 24
  # 更新包下载目录
  download_dir: "./data/updates"

# ==================== 离线缓存 ====================
cache:
  # 缓存库目录（cache.db 离线缓存、cache-notes.db「这天我干了什么」笔记）。
  # 空 = ~/.zentao-max（历史默认）。与 auth.db_path 一样属于基础部署配置，
  # 建议显式指定到应用数据目录，避免散落在用户主目录。
  # 环境变量：ZENTAO_MAX_CACHE_DIR
  dir: ""
