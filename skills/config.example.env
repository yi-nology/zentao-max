# 禅道技能包配置文件模板
# 复制到 ~/.zentao-credentials.env 后填写；也可以用 ZT_CRED 环境变量指向任意路径。
# 注意：本文件不要提交到代码仓库。

# 禅道域名（不要带 https://）
ZT_HOST=zentao.example.com

# 走 SSH 隧道时本机监听的端口；直连时设为 443
ZT_PORT=18443

# ~/.ssh/config 里的跳板机别名；留空 = 本机直连禅道
ZT_JUMPBOX=jumpbox

# 统一认证域（realm）。禅道不需要 realm 时留空
ZT_REALM=your-realm

# 登录账号与密码
ZT_USERNAME=your-account
ZT_PASSWORD=your-password

# PowerShell 脚本用的完整地址（可选）
# ZT_BASE=https://zentao.example.com